# Local config for the site. Copy to .env.local (git-ignored). It is loaded only by
# `pnpm dev` and `pnpm generate:local`; `generate` / `deploy` ignore it and use the live
# values from nuxt.config.ts (v3 plan, revision R1).

NUXT_PUBLIC_API_BASE=http://localhost:8787
# Cloudflare Turnstile test site key: always passes, issues XXXX.DUMMY.TOKEN.XXXX.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
