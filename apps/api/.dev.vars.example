# Local secrets for `wrangler dev` and tests. Copy to .dev.vars (git-ignored).
# Production values are set with `npx wrangler secret put <NAME>`.

# Cloudflare Turnstile test secret: always passes (accepts only the test token
# XXXX.DUMMY.TOKEN.XXXX). See ADR-019.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Optional: fill in to receive real Telegram messages locally. Empty = notifications skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin demo password (v4, ADR-021). Public on purpose: the login page shows it.
ADMIN_PASSWORD=linden-demo

# Stripe test mode (v7, docs/setup-integrations.md §8). Test keys only (sk_test_…);
# the API refuses any other key. The webhook secret is optional locally (§8.4).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
